{% extends 'layouts/page.njk' %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: "grants-config-browser"
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <div class="govuk-body" data-testid="app-page-body">
        <p>
          The config browser is a tool to help you find and inspect the configuration versions
           available via the grants-config-broker.
        </p>
        <p>
        To view the async-api documentation for the notifications emitted from the broker, on publish of
        a new config version, click <a href="/async-documentation">here</a>.
        </p>
        <p>
        To view the api documentation for the REST API for the broker, click <a href="/documentation">here</a>.
        </p>
      </div>
    </div>
  </div>

  {% if isAuthenticated %}
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">
        <h2 class="govuk-heading-m">User Information</h2>
        <p class="govuk-body">Signed in as {{ userDisplayName }}</p>
        {% if userRoles and userRoles.length > 0 %}
          <p class="govuk-body">Roles:</p>
          <ul class="govuk-list govuk-list--bullet">
            {% for role in userRoles %}
              <li>{{ role }}</li>
            {% endfor %}
          </ul>
        {% else %}
          <p class="govuk-body">No roles found for this user.</p>
        {% endif %}
      </div>
    </div>
  {% endif %}
{% endblock %}
