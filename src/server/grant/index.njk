{% extends 'layouts/page.njk' %}

{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <form method="GET">
        <input type="hidden" name="grant" value="{{ grant }}">
        {{ govukCheckboxes({
          name: "archived",
          classes: "govuk-checkboxes--small",
          formGroup: {
            classes: "govuk-!-margin-bottom-2"
          },
          items: [
            {
              value: "include",
              text: "Include archived versions",
              checked: archivedIncluded
            }
          ]
        }) }}
        {{ govukButton({
          text: "Apply",
          classes: "govuk-!-margin-bottom-4"
        }) }}
      </form>

      <div class="govuk-body" data-testid="app-page-body">
        <p></p>
        {% if versionTableRows.length %}
          <h2 class="govuk-heading-m govuk-!-static-margin-top-2">
            All versions
          </h2>

          <div>
            {{ govukTable({
            attributes: {
            'data-module': 'moj-sortable-table'
            },
            firstCellIsHeader: false,
            head: headers,
            rows: versionTableRows,
            classes: 'fixed-layout-table'
            }) }}
          </div>
        {% else %}
          <li>No versions available</li>
        {% endif %}

        {% if featureControlTableRows.length %}
          <h2 class="govuk-heading-m govuk-!-static-margin-top-8">
            Related feature controls
          </h2>

          <div>
            {{ govukTable({
              attributes: {
                'data-module': 'moj-sortable-table'
              },
              firstCellIsHeader: false,
              head: featureControlHeaders,
              rows: featureControlTableRows,
              classes: 'fixed-layout-table'
            }) }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>

{% endblock %}
