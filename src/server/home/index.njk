{% extends 'layouts/page.njk' %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <div class="govuk-body" data-testid="app-page-body">
        {% if showTruncationNote %}
          <p class="govuk-hint">Latest 3 non-archived versions shown. Click on each grant for more</p>
        {% endif %}
        {% for table in versionTables %}
          <h2 class="govuk-heading-m govuk-!-static-margin-top-2">
            <a href="/grant?grant={{table.title}}">{{table.title}}</a>
          </h2>

          <div>
            {{ govukTable({
            attributes: {
            'data-module': 'moj-sortable-table'
            },
            firstCellIsHeader: false,
            head: headers,
            rows: table.rows,
            classes: 'fixed-layout-table'
            }) }}
          </div>
        {% else %}
          <li>No versions available</li>
        {% endfor %}
      </div>
    </div>
  </div>

{% endblock %}
