{% extends 'layouts/page.njk' %}

{% block content %}

  {{ appHeading({
    text: heading
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column">
      <div class="govuk-body" data-testid="features-page-body">
        {% if featureTableRows.length %}
          <div>
            {{ govukTable({
              attributes: {
                'data-module': 'moj-sortable-table'
              },
              firstCellIsHeader: false,
              head: headers,
              rows: featureTableRows,
              classes: 'fixed-layout-table'
            }) }}
          </div>
        {% else %}
          <p class="govuk-!-margin-left-3">No features available</p>
        {% endif %}
      </div>
    </div>
  </div>

{% endblock %}
