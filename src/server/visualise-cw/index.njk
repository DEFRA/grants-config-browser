{% extends "layouts/page.njk" %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    <span class="govuk-caption-l">CW Visualisation</span>
    <div class="govuk-button-group">
      <h1 class="govuk-heading-l govuk-!-static-padding-right-5">{{ configName }}</h1>
      <button id="reset-zoom" class="govuk-button govuk-button--secondary" data-module="govuk-button">
        Reset Zoom
      </button>
    </div>

    <div class="journey-visualisation-container mermaid--pan-zoom govuk-!-margin-top-6" data-orientation="LR" data-type="cw" style="border: 1px solid #b1b4b6;">
      <pre class="mermaid">
        {{ mermaidGraph | safe }}
      </pre>
    </div>
  </div>
</div>

{% endblock %}
{% block bodyEnd %}
  {{ super() }}
  <script type="application/json" id="tooltip-data">
    {{ tooltipData | dump | safe }}
  </script>
  <script type="module" src="{{ getAssetPath('mermaid.js') }}"></script>
{% endblock %}
