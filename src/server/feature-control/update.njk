{% extends 'layouts/page.njk' %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block content %}
  {% if errors %}
    {{ govukErrorSummary({
      titleText: "There is a problem",
      errorList: errors.summary
    }) }}
  {% endif %}

  {{ appHeading({
    text: heading,
    caption: technicalName
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if featureControl.description %}
        <p class="govuk-body">{{ featureControl.description }}</p>
      {% endif %}
      <form method="post">
        <input type="hidden" name="name" value="{{ technicalName }}">
        {% if featureControl.type === 'boolean' %}
          {{ govukRadios({
            name: "value",
            errorMessage: errors.value if errors.value,
            fieldset: {
              legend: {
                text: "Value",
                isPageHeading: false,
                classes: "govuk-fieldset__legend--m"
              }
            },
            items: [
              {
                value: "true",
                text: "True",
                checked: submittedValue === "true" if submittedValue !== null else featureControl.value === true
              },
              {
                value: "false",
                text: "False",
                checked: submittedValue === "false" if submittedValue !== null else featureControl.value === false
              }
            ]
          }) }}
        {% else %}
          <p class="govuk-body">Update for {{ featureControl.type }} type is not yet supported. Only boolean updates are allowed for now.</p>
        {% endif %}

        {{ govukTextarea({
          name: "note",
          id: "note",
          value: note,
          errorMessage: errors.note if errors.note,
          label: {
            text: "Note",
            classes: "govuk-label--m"
          },
          hint: {
            text: "Explain why this change is being made."
          }
        }) }}

        <div class="govuk-button-group">
          {{ govukButton({
            text: "Save changes"
          }) }}
          <a class="govuk-link" href="/feature-control/detail?name={{ technicalName }}">Cancel</a>
        </div>
      </form>
    </div>
  </div>
{% endblock %}
